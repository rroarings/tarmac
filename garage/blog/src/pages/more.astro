---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const links = [
	{
		title: "About",
		href: "/about",
		description: "Learn about our mission and the team behind F1 Guide",
	},
	{
		title: "Contact",
		href: "/contact",
		description: "Get in touch with us for questions or feedback",
	},
	{
		title: "FAQs",
		href: "/faqs",
		description: "Find answers to commonly asked questions about F1",
	},
	{
		title: "Attributions",
		href: "/attributions",
		description: "Credits and acknowledgments for content and resources",
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={`More | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />
		<main class="container mx-auto px-4 py-12">
			<h1 class="text-4xl font-bold mb-8">More F1 Resources</h1>
			<p class="text-xl text-gray-600 mb-12">
				Discover additional resources and information about Formula 1 racing.
			</p>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					links.map(({ title, href, description }) => (
						<a
							href={href}
							class="block p-6 rounded-lg border border-gray-200">
							<h2 class="text-2xl font-bold mb-2">{title}</h2>
							<p class="text-gray-600">{description}</p>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>