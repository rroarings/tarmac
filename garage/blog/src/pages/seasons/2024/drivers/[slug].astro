---
import BaseHead from "../../../../components/BaseHead.astro"
import Header from "../../../../components/Header.astro"
import Footer from "../../../../components/Footer.astro"
import BreakpointIndicator from "../../../../components/BreakpointIndicator.astro"
import Breadcrumb from "../../../../components/Breadcrumb.astro"
import { SITE_TITLE } from "../../../../consts"
import { getCollection, getEntry } from "astro:content"
import StatCard from "../../../../components/StatCard.astro"

export async function getStaticPaths() {
	const drivers = await getCollection("drivers", ({ data }) => data.season === "2024")
	return drivers.map((driver) => ({
		params: { slug: driver.id.split("/").pop() },
		props: { driver },
	}))
}

const { driver } = Astro.props
// Import the Content component separately
import { render } from "astro:content"
const { Content, headings } = await render(driver)
---

<!doctype html>
<html
	lang="en"
	class="bg-gray-100 dark:bg-slate-950">
	<head>
		<BaseHead
			title={`${driver.data.firstName} ${driver.data.lastName} | ${SITE_TITLE}`}
			description={`2024 F1 driver profile for ${driver.data.firstName} ${driver.data.lastName} driving for ${driver.data.team}`}
		/>
	</head>
	<body>
		<BreakpointIndicator />
		<Header />
		<main>
			<!-- Driver Profile Header -->
			<section class="py-16 bg-gray-100 dark:bg-slate-950">
				<div class="container mx-auto px-4">
					<Breadcrumb
						items={[
							{ text: "Home", href: "/" },
							{ text: "2024 Season", href: "/seasons/2024/" },
							{ text: "Drivers", href: "/seasons/2024/drivers" },
							{ text: `${driver.data.firstName} ${driver.data.lastName}` },
						]}
					/>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
						<div>
							<img
								src={(
									driver.data.profileImage &&
									driver.data.profileImage.startsWith("/blog-placeholder")
								) ?
									driver.data.profileImage
								:	"/blog-placeholder-1.jpg"}
								alt={`${driver.data.firstName} ${driver.data.lastName}`}
								class="w-full h-64 object-cover p-3"
							/>
						</div>
						<div>
							<h1 class="text-4xl font-bold mb-4 dark:text-slate-100">
								{driver.data.firstName}
								<span class="">{driver.data.lastName}</span>
							</h1>
							<div class="space-y-3 text-lg">
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Number:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.number}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Team:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.team}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Nationality:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.nationality}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Age:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.age}</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Driver Statistics -->
			<section class="py-12 bg-slate-100 dark:bg-slate-950">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl font-bold mb-8 text-center dark:text-slate-200">Career Statistics</h2>

					<div class="max-w-7xl mx-auto">
						<div class="flex flex-wrap -mx-2">
							<StatCard
								value={driver.data.championships}
								label="Championships"
							/>
							<StatCard
								value={driver.data.raceWins}
								label="Race Wins"
							/>
							<StatCard
								value={driver.data.podiums}
								label="Podiums"
							/>
							<StatCard
								value={driver.data.points}
								label="Career Points"
							/>
						</div>
					</div>
				</div>
			</section>

			<!-- Driver Biography -->
			<section class="py-12 bg-gray-100 dark:bg-slate-950">
				<div class="prose prose-lg dark:prose-invert max-w-none">
					<Content />
				</div>
			</section>

			<!-- Back Links -->
			<section class="py-8 text-center">
				<div class="space-x-4">
					<a
						href="/seasons/2024/drivers"
						class="inline-block border-2 border-transparent transition-colors duration-300 bg-rose-600 dark:border-rose-600 dark:hover:bg-rose-800 hover:bg-rose-700 dark:hover:border-rose-600 text-white py-2 px-4 rounded">
						← Back to 2024 Drivers
					</a>
					<a
						href="/seasons/2024"
						class="inline-block border-2 border-transparent transition-colors duration-300 bg-slate-600 dark:border-slate-600 dark:hover:bg-slate-800 hover:bg-slate-700 text-white py-2 px-4 rounded">
						← Back to 2024 Season
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
