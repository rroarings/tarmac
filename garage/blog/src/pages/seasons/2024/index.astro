---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import RaceCalendar from "../../../components/RaceCalendar.astro";
import DriverCard from "../../../components/DriverCard.astro";
import BreakpointIndicator from "../../../components/BreakpointIndicator.astro";
import { SITE_TITLE } from "../../../consts";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
// Map posts to include slug, title, and heroImage from data
const formattedPosts = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  heroImage: post.data.heroImage,
}));

// Limit the formattedPosts array to the latest 3 posts
const latestPosts = formattedPosts.slice(0, 3);

// Get 2025 season drivers
const drivers = await getCollection("drivers", ({ data }) => {
  return data.season === "2024";
});

// Sort drivers by championship position (1-24)
const sortedDrivers = drivers.sort((a, b) => {
  // Use championship position first, if equal fall back to points
  if (a.data.championshipPosition !== b.data.championshipPosition) {
    return a.data.championshipPosition - b.data.championshipPosition;
  }
  return b.data.points - a.data.points;
});

// Get top 3 drivers for the grid section
const topDrivers = sortedDrivers.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`2024 F1 Season | ${SITE_TITLE}`}
      description="Complete 2024 Formula 1 race calendar and season overview"
    />
  </head>
  <body>
    <BreakpointIndicator />
    <Header />
    <main>
      <!-- 2024 Season Header -->
      <section class="pt-6 pb-6 text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl font-bold mb-4">2024 Formula 1 Season</h1>
          <p class="text-lg text-gray-700">
            Complete race calendar and season overview
          </p>
        </div>
      </section>

      <!-- Quick Links -->
      <section class="py-6">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Drivers Link -->
            <div
              class="bg-gray-100 border border-gray-300 rounded p-6 text-center flex flex-col h-full"
            >
              <div class="flex-grow">
                <i class="bi bi-person-badge text-4xl text-gray-700 mb-4"></i>
                <h3 class="text-xl">2024 Drivers</h3>
                <p class="text-gray-600 mb-4">
                  Explore driver profiles and statistics
                </p>
              </div>
              <div>
                <a
                  href="/seasons/2024/drivers"
                  class="bg-gray-800 transition-all duration-300 hover:bg-red-600 text-white font-bold py-2 px-4 rounded"
                  >View Drivers</a
                >
              </div>
            </div>

            <!-- Teams Link -->
            <div
              class="bg-gray-100 border border-gray-300 rounded p-6 text-center flex flex-col h-full"
            >
              <div class="flex-grow">
                <i class="bi bi-car-front text-4xl text-gray-700 mb-4"></i>
                <h3 class="text-xl">2024 Teams</h3>
                <p class="text-gray-600 mb-4">
                  Learn about constructor teams and their cars
                </p>
              </div>
              <div>
                <a
                  href="/seasons/2024/teams"
                  class="bg-gray-800 transition-all duration-300 hover:bg-red-600 text-white font-bold py-2 px-4 rounded"
                  >View Teams</a
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 2024 Drivers Section -->
      <section class="py-5">
        <div class="mx-auto">
          <div class="p-6">
            <header class="flex items-center gap-3 mb-6">
              <h2 class="text-2xl font-bold">
                Explore the 2024 Season Drivers
              </h2>
            </header>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {
                topDrivers.map((driver) => (
                  <DriverCard driver={driver} year="2024" />
                ))
              }
            </div>
            <div class="mt-8">
              <a
                href="/seasons/2024/drivers"
                class="text-gray-600 transition-all duration-300 hover:text-blue-600 py-2 px-4 rounded"
              >
                View All 2024 Drivers
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Race Calendar -->
      <section class="py-6">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-bold mb-8">The 2024 Race Calendar</h2>
          <RaceCalendar season="2024" showAllRaces={true} />
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
