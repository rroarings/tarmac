---
import BaseHead from "../../../../components/BaseHead.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import BreakpointIndicator from "../../../../components/BreakpointIndicator.astro";
import { SITE_TITLE } from "../../../../consts";
import { getCollection } from "astro:content";

// Get all teams for 2025 season
const teams = await getCollection("teams", ({ data }) => {
  return data.season === "2025";
});

// Get all drivers for 2025 season to match with teams
const drivers = await getCollection("drivers", ({ data }) => {
  return data.season === "2025";
});

// Map driver names to their profile image and slug
const driverMap = new Map();
drivers.forEach((driver) => {
  const fullName = `${driver.data.firstName} ${driver.data.lastName}`;
  driverMap.set(fullName, {
    profileImage: driver.data.profileImage,
    slug: driver.id,
    countryCode: driver.data.countryCode,
  });
});

// Sort teams by championship position (1-10), falling back to constructor points
const sortedTeams = teams.sort((a, b) => {
  // Use championship position first, if equal fall back to constructor points
  if (a.data.championshipPosition !== b.data.championshipPosition) {
    return a.data.championshipPosition - b.data.championshipPosition;
  }
  if (b.data.constructorPoints !== a.data.constructorPoints) {
    return b.data.constructorPoints - a.data.constructorPoints;
  }
  return b.data.championships - a.data.championships;
});

// Import team backgrounds
import williamsBG from "../../../../assets/components/driverCard-template-williams.png";
import ferrariBG from "../../../../assets/components/driverCard-template-ferrari.png";
import kickSauberBG from "../../../../assets/components/driverCard-template-kicksauber.png";
import mclarenBG from "../../../../assets/components/driverCard-template-mclaren.png";
import mercedesBG from "../../../../assets/components/driverCard-template-mercedes.png";
import astonMartinBG from "../../../../assets/components/driverCard-template-astonmartin.png";
import haasBG from "../../../../assets/components/driverCard-template-haas.png";
import alpineBG from "../../../../assets/components/driverCard-template-alpine.png";
import racingBullsBG from "../../../../assets/components/driverCard-template-racingBulls.png";
import redBullBG from "../../../../assets/components/driverCard-template-redbull.png";
import { Image } from "astro:assets";

// Team background mapping
const teamBgMap: Record<string, any> = {
  McLaren: mclarenBG,
  Ferrari: ferrariBG,
  Mercedes: mercedesBG,
  "Red Bull Racing": redBullBG,
  Williams: williamsBG,
  "Kick Sauber": kickSauberBG,
  "Racing Bulls": racingBullsBG,
  "Aston Martin": astonMartinBG,
  Haas: haasBG,
  Alpine: alpineBG,
};

const eagerCount = 4;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`2025 F1 Teams | ${SITE_TITLE}`}
      description="2025 Formula 1 constructor teams and their cars"
    />
  </head>
  <body>
    <BreakpointIndicator />
    <Header />
    <main>
      <Breadcrumb
        items={[
          { text: "Home", href: "/" },
          { text: "Seasons", href: "/seasons" },
          { text: "2025 Season", href: "/seasons/2025/" },
          { text: "Constructors", href: "/seasons/2025/teams" },
        ]}
      />

      <!-- Teams Header -->
      <section class="py-16 text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl font-bold mb-4">2025 Formula 1 Constructors</h1>
          <p class="text-lg text-gray-700">
            Constructor teams and their racing machines
          </p>
        </div>
      </section>

      <!-- Teams Grid -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
              sortedTeams.map((team, teamIndex) => {
                const teamBg = teamBgMap[team.data.name] || null;
                return (
                  <a
                    href={`/seasons/2024/teams/${team.id}`}
                    class="h-full block group"
                  >
                    <article
                      class="border border-gray-300 shadow-md rounded-lg overflow-hidden h-full flex flex-col hover:shadow-lg transition-shadow relative bg-white"
                      style={
                        teamBg
                          ? `background-image: url('${teamBg.src}'); background-size: cover; background-position: center;`
                          : ""
                      }
                    >
                      <div class="relative z-10 flex flex-col flex-1 h-full">
                        {/* Team Section */}
                        <div class="text-gray-100 border-b border-gray-100/20">
                          <div class="p-4">
                            <h3 class="text-lg font-bold mb-2 flex items-center justify-between">
                              <span>{team.data.name}</span>
                              <span class="font-semibold text-2xl">
                                {team.data.constructorPoints}
                                <span class="text-base font-normal">pts</span>
                              </span>
                            </h3>

                            {/* Driver Name + Avatars under team name */}
                            <div class="mt-2 flex flex-col gap-3 lg:flex-row lg:gap-6 lg:items-center lg:justify-start">
                              {team.data.drivers.map((driverName) => {
                                let driverInfo = driverMap.get(driverName);
                                return (
                                  <div class="flex items-center gap-2 mb-1">
                                    <div class="size-6 rounded-full overflow-hidden bg-gray-300/20 flex-shrink-0 border border-gray-50/30 flex items-center justify-center">
                                      <Image
                                        src={driverInfo?.profileImage}
                                        alt={driverName}
                                        class="object-cover"
                                        width="32"
                                        height="32"
                                        loading={
                                          teamIndex < eagerCount
                                            ? "eager"
                                            : "lazy"
                                        }
                                      />
                                    </div>
                                    <span class="text-sm">{driverName}</span>
                                  </div>
                                );
                              })}
                            </div>
                          </div>
                        </div>

                        {/* Team Details (optional, still hidden) */}
                        <div class="p-4 pt-2 hidden">
                          <div class="text-sm text-gray-100 space-y-2 mt-2">
                            <div class="flex justify-between items-center">
                              <span>Team Principal:</span>
                              <span class="font-medium">
                                {team.data.principal}
                              </span>
                            </div>
                            <div class="flex justify-between items-center">
                              <span>Engine:</span>
                              <span>{team.data.engine}</span>
                            </div>
                            <div class="flex justify-between items-center">
                              <span>Car:</span>
                              <span>{team.data.carModel}</span>
                            </div>
                          </div>
                        </div>
                      </div>
                      {/* Car Image - always flush to bottom, with blur overlay only here */}
                      <div class="relative overflow-hidden bg-gradient-to-t from-gray-900 to-gray-900/20 ">
                        {/* Blurred background layer */}
                        <div class="absolute inset-0 backdrop-blur-[4px] pointer-events-none z-0" />
                        {/* Car image stays sharp above the blur */}
                        <Image
                          src={team.data.carImageLarge || team.data.carImage}
                          alt={`${team.data.name} ${team.data.carModel}`}
                          class="w-full h-48 object-cover relative z-10"
                          loading={teamIndex < eagerCount ? "eager" : "lazy"}
                        />
                      </div>
                    </article>
                  </a>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Back Link -->
      <section class="py-8 text-center">
        <a
          href="/seasons/2025"
          class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded"
        >
          ← Back to 2025 Season
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>
