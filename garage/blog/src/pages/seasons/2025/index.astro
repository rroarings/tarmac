---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import RaceCalendar from "../../../components/RaceCalendar.astro";
import Standings from "../../../components/Standings.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import SeasonNavCards from "../../../components/SeasonNavCards.astro";
import { SITE_TITLE } from "../../../consts";
import BreakpointIndicator from "../../../components/BreakpointIndicator.astro";
import LatestBlogPosts from "../../../components/LatestBlogPosts.astro";
---

<!doctype html>
<html lang="en" class="bg-gray-100 dark:bg-slate-950">
  <head>
    <BaseHead
      title={`2025 F1 Season | ${SITE_TITLE}`}
      description="Complete 2025 Formula 1 race calendar and season overview"
    />
  </head>
  <body>
    <BreakpointIndicator />
    <Header />
    <main>
      <Breadcrumb
        items={[
          { text: "Home", href: "/" },
          { text: "Seasons", href: "/seasons" },
          { text: "2025 Season", href: "/seasons/2025" },
        ]}
      />

      <!-- 2025 Season Header -->
      <section class="pt-6 pb-6 text-center dark:text-slate-100">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl font-bold mb-4">State of the Season</h1>
          <p
            class="max-w-3xl mx-auto text-lg text-gray-700 dark:text-slate-400"
          >
            The 2025 season is shaping up to be a thriller. With new regulations
            shaking up the grid and fierce rivalries igniting, follow along for
            real-time standings, race results, and in-depth analysis.
          </p>
        </div>
      </section>

      <!-- Driver / Constructor Nav Cards -->
      <SeasonNavCards season="2025" />

      <!-- Standings Section -->
      <section class="py-16 bg-gray-100 dark:bg-slate-950">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-bold mb-6 text-center dark:text-slate-100">
            2025 Championship Standings
          </h2>

          <Standings season="2025" imageLoading="eager" />
        </div>
      </section>

      <!-- Race Calendar -->
      <section class="py-16 bg-gray-100 dark:bg-slate-950">
        <div class="container mx-auto px-4">
          <h2 class="text-2xl font-bold mb-8 text-center dark:text-slate-100">
            Race Spotlight: What's Next on the Calendar
          </h2>
          <RaceCalendar
            season="2025"
            showAllRaces={false}
            showTitle={true}
            eagerCount={0}
          />
        </div>
      </section>

      <!-- Latest Blog Posts Section -->
      <LatestBlogPosts />
    </main>
    <Footer />
  </body>
</html>
