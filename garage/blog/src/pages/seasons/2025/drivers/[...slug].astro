---
import BaseHead from "../../../../components/BaseHead.astro"
import Header from "../../../../components/Header.astro"
import Footer from "../../../../components/Footer.astro"
import Breadcrumb from "../../../../components/Breadcrumb.astro"
import { SITE_TITLE } from "../../../../consts"
import { getCollection } from "astro:content"

export async function getStaticPaths() {
	const drivers = await getCollection("drivers", ({ data }) => data.season === "2025")
	return drivers.map((driver) => {
		const slug = driver.id.split("/").pop()
		return {
			params: { slug },
			props: { driver },
		}
	})
}

const { driver } = Astro.props
// Import the Content component separately
import { render } from "astro:content"
const { Content } = await render(driver)
---

<!doctype html>
<html
	lang="en"
	class="bg-gray-100 dark:bg-slate-950">
	<head>
		<BaseHead
			title={`${driver.data.firstName} ${driver.data.lastName} | ${SITE_TITLE}`}
			description={`2025 F1 driver profile for ${driver.data.firstName} ${driver.data.lastName} driving for ${driver.data.team}`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb
				items={[
					{ text: "Home", href: "/" },
					{ text: "2025 Season", href: "/seasons/2025/" },
					{ text: "Drivers", href: "/seasons/2025/drivers" },
					{ text: `${driver.data.firstName} ${driver.data.lastName}` },
				]}
			/>

			<!-- Driver Profile Header -->
			<section class="py-16 bg-gray-100 dark:bg-slate-950">
				<div class="container mx-auto px-4">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
						<div>
							<img
								src={driver.data.profileImageLarge || driver.data.profileImage || "/blog-placeholder-1.jpg"}
								alt={`${driver.data.firstName} ${driver.data.lastName}`}
								class=""
								loading="lazy"
							/>
						</div>
						<div>
							<h1 class="text-4xl font-bold mb-4 dark:text-slate-100">
								{driver.data.firstName}
								<span class="">{driver.data.lastName}</span>
							</h1>
							<div class="space-y-3 text-lg">
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Number:</span>
									<span class="px-3 py-1 rounded font-bold dark:text-slate-300">#{driver.data.number}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Team:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.team}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Nationality:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.nationality}</span>
								</div>
								<div class="flex items-center">
									<span class="w-32 dark:text-slate-400">Age:</span>
									<span class="text-gray-700 dark:text-slate-300">{driver.data.age}</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Driver Statistics -->
			<section class="py-12 bg-gray-100 dark:bg-slate-950">
				<div class="container mx-auto px-4">
					<h2 class="text-3xl font-bold mb-10 text-center relative">
						<span class="inline-block pb-2 dark:text-slate-200">Career Statistics</span>
					</h2>

					<div class="flex flex-wrap justify-center">
						<div class="w-full max-w-4xl mx-auto">
							<div class="flex flex-wrap -mx-2">
								<!-- Championships -->
								<div class="w-1/2 md:w-1/4 px-2 mb-6">
									<div class="dark:bg-gray-900 border border-gray-300 dark:border-slate-700 rounded-lg transition duration-300 hover:border-gray-400">
										<div class="p-6 text-center">
											<div class="text-4xl font-bold mb-1 dark:text-slate-200">{driver.data.championships}</div>
											<div class="text-sm text-gray-600 dark:text-slate-400 uppercase tracking-wide">Championships</div>
										</div>
									</div>
								</div>

								<!-- Race Wins -->
								<div class="w-1/2 md:w-1/4 px-2 mb-6">
									<div class="dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-lg transition duration-300 hover:border-gray-400">
										<div class="p-6 text-center">
											<div class="text-4xl font-bold mb-1 dark:text-slate-200">{driver.data.raceWins}</div>
											<div class="text-sm text-gray-600 dark:text-slate-400 uppercase tracking-wide">Race Wins</div>
										</div>
									</div>
								</div>

								<!-- Podiums -->
								<div class="w-1/2 md:w-1/4 px-2 mb-6">
									<div class="dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-lg transition duration-300 hover:border-gray-400">
										<div class="p-6 text-center">
											<div class="text-4xl font-bold mb-1 dark:text-slate-200">{driver.data.podiums}</div>
											<div class="text-sm text-gray-600 dark:text-slate-400 uppercase tracking-wide">Podiums</div>
										</div>
									</div>
								</div>

								<!-- Points -->
								<div class="w-1/2 md:w-1/4 px-2 mb-6">
									<div class="dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-lg transition duration-300 hover:border-gray-400">
										<div class="p-6 text-center">
											<div class="text-4xl font-bold mb-1 dark:text-slate-200">{driver.data.points}</div>
											<div class="text-sm text-gray-600 dark:text-slate-400 uppercase tracking-wide">Career Points</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Driver Biography -->
			<section class="py-12 bg-gray-100 dark:bg-slate-950">
				<div class="prose prose-lg dark:prose-invert max-w-none">
					<Content />
				</div>
			</section>

			<!-- Back Links -->
			<section class="py-8 text-center">
				<div class="space-x-4">
					<a
						href="/seasons/2025/drivers"
						class="inline-block border-2 border-transparent transition-colors duration-300 bg-rose-600 dark:border-rose-600 dark:hover:bg-rose-800 hover:bg-rose-700 dark:hover:border-rose-600 text-white py-2 px-4 rounded">
						← Back to 2025 Drivers
					</a>
					<a
						href="/seasons/2025"
						class="inline-block border-2 border-transparent transition-colors duration-300 bg-slate-600 dark:border-slate-600 dark:hover:bg-slate-800 hover:bg-slate-700 text-white py-2 px-4 rounded">
						← Back to 2025 Season
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
