---
import BaseHead from "../../../../components/BaseHead.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import RaceCalendar from "../../../../components/RaceCalendar.astro";
import { SITE_TITLE } from "../../../../consts";
---

<!doctype html>
<html lang="en" class="bg-gray-100 dark:bg-slate-950">
  <head>
    <BaseHead
      title={`2025 F1 Races | ${SITE_TITLE}`}
      description="Complete list of races for the 2025 Formula 1 season"
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- 2025 Races Header -->
      <section class="pt-6 pb-6 text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-4xl font-bold mb-4 dark:text-slate-100">
            2025 Formula 1 Races
          </h1>
          <p class="text-lg text-gray-700 dark:text-slate-400">
            Complete race calendar for the 2025 season
          </p>
        </div>
      </section>

      <!-- Navigation -->
      <section class="py-6">
        <div class="container mx-auto px-4 flex justify-between">
          <a
            href="/seasons/2025"
            class="inline-block border-2 border-transparent transition-all duration-300 bg-red-600 hover:bg-red-700 dark:bg-rose-600 dark:hover:bg-rose-700 dark:hover:border-rose-500 dark:text-slate-100 text-white font-bold py-2 px-4 rounded"
          >
            Back to 2025 Season
          </a>
          <a
            href="/seasons/2024/races"
            class="inline-block border-2 border-transparent transition-all duration-300 bg-gray-600 hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-800 dark:hover:border-slate-600 text-white font-bold py-2 px-4 rounded"
          >
            View 2024 Races
          </a>
        </div>
      </section>

      <!-- Race Calendar -->
      <section class="py-6">
        <div class="container mx-auto px-4">
          <RaceCalendar season="2025" showAllRaces={true} eagerCount={6} />
        </div>
      </section>

      <!-- Back Link -->
      <section class="py-8 text-center">
        <a
          href="/seasons/2025"
          class="border-2 border-transparent transition-all duration-300 bg-gray-600 hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-800 dark:hover:border-slate-600 text-white font-bold py-2 px-4 rounded"
        >
          ← Back to 2025 Season
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>
