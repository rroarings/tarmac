---
import { getCollection } from "astro:content"
import BaseHead from "../../../../components/BaseHead.astro"
import Header from "../../../../components/Header.astro"
import Footer from "../../../../components/Footer.astro"
import FormattedDate from "../../../../components/FormattedDate.astro"
import Breadcrumb from "../../../../components/Breadcrumb.astro"
import { SITE_TITLE } from "../../../../consts"

export async function getStaticPaths() {
	const races = await getCollection("races", ({ data }) => {
		return data.season === "2025"
	})

	return races.map((race) => {
		const parts = race.id.split("/")
		const slug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "")
		return {
			params: { slug },
			props: { race },
		}
	})
}

const { race } = Astro.props
// Import the Content component
import { render } from "astro:content"
const { Content } = await render(race)
---

<!doctype html>
<html
	lang="en"
	class="bg-gray-100 dark:bg-slate-950">
	<head>
		<BaseHead
			title={`${race.data.trackName} | ${SITE_TITLE}`}
			description={`Information about the ${race.data.trackName} Grand Prix of the 2025 Formula 1 season`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<Breadcrumb
				items={[
					{ text: "Formula 1", href: "/" },
					{ text: "2025 Season", href: "/seasons/2025/" },
					{ text: "Races", href: "/seasons/2025/races" },
					{ text: `Race #${race.data.raceNumber}` },
				]}
			/>

			<!-- Race Header - Left aligned without background -->
			<section class="race-header pt-16">
				<div class="container mx-auto px-4">
					<h1 class="text-4xl font-bold mb-2 dark:text-slate-100">{race.data.trackName}</h1>
					<p class="text-gray-700 dark:text-slate-400">
						<FormattedDate date={race.data.date} /> • {race.data.location}
					</p>
				</div>
			</section>

			<!-- Race Status -->
			<section class="py-4">
				<div class="container mx-auto px-4">
					<div class="text-left">
						{
							race.data.completed ?
								<span class="inline-block bg-green-100 dark:bg-green-700 border border-green-300 dark:border-green-600 text-green-800 dark:text-white px-4 py-2 rounded transition-colors duration-300 dark:hover:bg-green-800">
									Race Completed
								</span>
							:	<span class="inline-block bg-gray-100 dark:bg-slate-700 border border-gray-300 dark:border-slate-600 text-gray-800 dark:text-white px-4 py-2 rounded transition-colors duration-300 dark:hover:bg-slate-800">
									Upcoming Race
								</span>
						}
					</div>
				</div>
			</section>

			<!-- Race Details -->
			<section class="py-8">
				<div class="container mx-auto px-4">
					<!-- Race Stats -->
					<div class="border border-gray-300 dark:border-slate-800 rounded-lg p-6 mb-8 shadow-sm">
						<h2 class="text-2xl font-bold mb-4 dark:text-slate-200">Race Details</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								<ul class="space-y-3">
									<li class="flex justify-between">
										<span class="dark:text-slate-400">Date:</span>
										<span class="text-gray-600 dark:text-slate-300"
											><FormattedDate date={race.data.date} /></span
										>
									</li>
									<li class="flex justify-between">
										<span class="dark:text-slate-400">Location:</span>
										<span class="text-gray-600 dark:text-slate-300">{race.data.location}</span>
									</li>
									<li class="flex justify-between">
										<span class="dark:text-slate-400">Race Number:</span>
										<span class="text-gray-600 dark:text-slate-300">{race.data.raceNumber}</span>
									</li>
								</ul>
							</div>

							{
								race.data.completed && (
									<div>
										<ul class="space-y-3">
											<li class="flex justify-between">
												<span class="dark:text-slate-400">Winner:</span>
												<span class="text-gray-600 dark:text-slate-300">{race.data.winner}</span>
											</li>
											<li class="flex justify-between">
												<span class="dark:text-slate-400">Winning Team:</span>
												<span class="text-gray-600 dark:text-slate-300">
													{race.data.winningTeam}
												</span>
											</li>
											<li class="flex justify-between">
												<span class="dark:text-slate-400">Fastest Lap:</span>
												<span class="text-gray-600 dark:text-slate-300">
													{race.data.fastestLapTime}
													{race.data.fastestLapDriver && ` (${race.data.fastestLapDriver})`}
												</span>
											</li>
										</ul>
									</div>
								)
							}
						</div>
					</div>

					<!-- Race Content -->
					<div class="race-content prose dark:prose-invert max-w-none">
						<Content />
					</div>
				</div>
			</section>

			<!-- Back to Races -->
			<section class="py-6">
				<div class="container mx-auto px-4 text-center space-x-4">
					<a
						href="/seasons/2025/races"
						class="inline-block border-2 border-transparent transition-all duration-300 bg-rose-600 hover:bg-rose-700 dark:bg-rose-600 dark:hover:bg-rose-700 dark:hover:border-rose-500 dark:text-slate-100 text-white py-2 px-4 rounded text-center">
						← Back to 2025 Races
					</a>
					<a
						href="/seasons/2025"
						class="inline-block border-2 border-transparent transition-all duration-300 bg-slate-600 hover:bg-slate-700 dark:bg-slate-600 dark:hover:bg-slate-700 dark:hover:border-slate-500 dark:text-slate-100 text-white py-2 px-4 rounded text-center">
						← Back to 2025 Season
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
