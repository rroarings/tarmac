---
import BaseHead from "../components/BaseHead.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"
import QuestionsCard from "../components/QuestionsCard.astro"

var SITE_TITLE = "Contact Us"
var SITE_DESCRIPTION = "Send us a message or connect with us on social media."
---

<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="bg-gray-50 text-gray-800">
		<Header />
		<main class="max-w-4xl mx-auto py-20">
			<h1 class="font-bold text-center">Contact Us</h1>
			<p class="text-center mb-6">Connect with us on your favorite social platforms.</p>

			<div class="space-y-8 max-w-6xl mx-auto py-20">
				<div
					class="border border-gray-200 rounded-lg p-6 flex gap-4 duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 group">
					<i class="bi bi-github text-3xl transition-colors duration-300 ease-in-out"></i>
					<div class="flex-1">
						<p class="transition-colors duration-300 ease-in-out">GitHub</p>
						<p
							class="text-base transition-colors duration-300 ease-in-out group-hover:text-gray-400">
							Our project is proudly hosted on GitHub, where you can explore the code behind our
							Formula 1 blog and personal projects. Dive into the repository to see how we bring
							race updates, behind-the-scenes stories, and personal insights to life.
						</p>
						<a
							href="https://github.com/rroarings"
							class="text-gray-600 hover:underline group-hover:text-gray-300 group-hover:underline-offset-8 mt-2 block transition-all duration-300 ease-in-out"
							>Visit our GitHub →</a
						>
					</div>
				</div>

				<div
					class="border border-gray-200 rounded-lg p-6 flex gap-4 duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 group">
					<i class="bi bi-linkedin text-3xl transition-colors duration-300 ease-in-out"></i>
					<div class="flex-1">
						<p class="transition-colors duration-300 ease-in-out">LinkedIn</p>
						<p
							class="text-base transition-colors duration-300 ease-in-out group-hover:text-gray-400">
							Find me on LinkedIn.
						</p>
						<a
							href="https://www.linkedin.com/in/nick-calvo-56b61218b/"
							class="text-gray-600 hover:underline group-hover:text-gray-300 group-hover:underline-offset-8 mt-2 block transition-all duration-300 ease-in-out"
							>Visit our LinkedIn →</a
						>
					</div>
				</div>

				<div
					class="border border-gray-200 rounded-lg p-6 flex gap-4 duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 group">
					<i class="bi bi-globe text-3xl transition-colors duration-300 ease-in-out"></i>
					<div class="flex-1">
						<p class="transition-colors duration-300 ease-in-out">Personal Website</p>
						<p
							class="text-base transition-colors duration-300 ease-in-out group-hover:text-gray-400">
							Find me on my personal website.
						</p>
						<a
							href="https://www.notnickcalvo.com"
							class="text-gray-600 hover:underline group-hover:text-gray-300 group-hover:underline-offset-8 mt-2 block transition-all duration-300 ease-in-out"
							>Visit my personal site →</a
						>
					</div>
				</div>

				<div
					class="border border-gray-200 rounded-lg p-6 flex gap-4 duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 group">
					<i class="bi bi-youtube text-3xl transition-colors duration-300 ease-in-out"></i>
					<div class="flex-1">
						<p class="transition-colors duration-300 ease-in-out">YouTube</p>
						<p
							class="text-base transition-colors duration-300 ease-in-out group-hover:text-gray-400">
							Lorem commodo duis ut nisi anim dolore eiusmod et esse laborum nulla sit. Lorem sit
							cillum esse duis incididunt excepteur duis sint laborum. Amet cillum cupidatat non et
							nulla occaecat ipsum esse enim nisi ea sint labore mollit.
						</p>
						<a
							href="https://www.youtube.com/@0vlack"
							class="text-gray-600 hover:underline group-hover:text-gray-300 group-hover:underline-offset-8 mt-2 block transition-all duration-300 ease-in-out"
							>Visit our YouTube →</a
						>
					</div>
				</div>
			</div>

			<QuestionsCard />
		</main>

		<Footer />
	</body>
</html>
