---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import QuestionsCard from "../components/QuestionsCard.astro";

var SITE_TITLE = "Contact Us";
var SITE_DESCRIPTION = "Send us a message or connect with us on social media.";

const contacts = [
  {
    icon: "bi bi-github",
    label: "GitHub",
    description:
      "Our project is proudly hosted on GitHub, where you can explore the code behind our Formula 1 blog and personal projects. Dive into the repository to see how we bring race updates, behind-the-scenes stories, and personal insights to life.",
    link: "https://github.com/rroarings",
    linkText: "Visit our GitHub →",
  },
  {
    icon: "bi bi-linkedin",
    label: "LinkedIn",
    description: "Find me on LinkedIn.",
    link: "https://www.linkedin.com/in/nick-calvo-56b61218b/",
    linkText: "Visit our LinkedIn →",
  },
  {
    icon: "bi bi-globe",
    label: "Personal Website",
    description: "Find me on my personal website.",
    link: "https://www.notnickcalvo.com",
    linkText: "Visit my personal site →",
  },
  {
    icon: "bi bi-youtube",
    label: "YouTube",
    description:
      "Lorem commodo duis ut nisi anim dolore eiusmod et esse laborum nulla sit. Lorem sit cillum esse duis incididunt excepteur duis sint laborum. Amet cillum cupidatat non et nulla occaecat ipsum esse enim nisi ea sint labore mollit.",
    link: "https://www.youtube.com/@0vlack",
    linkText: "Visit our YouTube →",
  },
];
---

<html lang="en" class="bg-gray-100 dark:bg-slate-950">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="max-w-4xl mx-auto py-20">
      <h1 class="font-bold text-center dark:text-slate-100">Contact Us</h1>
      <p class="text-center mb-6 dark:text-slate-400">
        Connect with us on your favorite social platforms.
      </p>

      <div class="space-y-8 max-w-6xl mx-auto py-20">
        {
          contacts.map((contact) => (
            <div class="border border-gray-200 dark:border-slate-700 dark:bg-slate-900 rounded-lg p-6 flex gap-4 duration-300 ease-in-out hover:bg-gray-800 hover:text-gray-300 group">
              <i
                class={
                  contact.icon +
                  " text-3xl dark:text-slate-100 transition-colors duration-300 ease-in-out"
                }
              />
              <div class="flex-1">
                <p class="dark:text-slate-100 transition-colors duration-300 ease-in-out">
                  {contact.label}
                </p>
                <p class="text-base dark:text-slate-400 transition-colors duration-300 ease-in-out group-hover:text-gray-400">
                  {contact.description}
                </p>
                <a
                  href={contact.link}
                  class="text-gray-600 dark:text-slate-500 group-hover:underline group-hover:text-gray-300 mt-2 block transition-all duration-300 ease-in-out"
                >
                  {contact.linkText}
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <QuestionsCard />
    </main>

    <Footer />
  </body>
</html>
