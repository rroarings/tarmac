---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import BreakpointIndicator from "../../components/BreakpointIndicator.astro";
import TwoColumnSection from "../../components/TwoColumnSection.astro";
import jp02 from "/src/assets/circuits/03japan/jp02.jpg";
import bh03 from "/src/assets/circuits/04bahrain/bh03.jpg";

const pageTitle = "Technology of Formula 1";
const description =
  "Formula 1 is at the cutting edge of automotive technology, pushing boundaries in engineering, data analytics, and innovation.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={description} />
  </head>
  <body>
    <BreakpointIndicator />
    <Header />

    <main>
      <!-- Hero Section -->
      <section
        class="py-10 bg-gradient-to-b from-slate-50 to-white overflow-hidden"
      >
        <div class="container mx-auto px-4">
          <div class="text-center mb-10">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{pageTitle}</h1>
            <p class="text-xl text-gray-600">
              Technological prowess drives Formula 1 innovation
            </p>
          </div>

          <!-- Technology Grid Layout -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Engineering -->
            <div class="group relative rounded-xl overflow-hidden">
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <div
                  class="flex flex-col items-center text-center mb-6 relative overflow-hidden"
                >
                  <div class="bg-red-50 p-4 rounded-full">
                    <i
                      class="bi bi-gear-fill text-red-500 text-2xl inline-block"
                    ></i>
                  </div>
                  <h3 class="text-lg text-gray-800 mt-4">
                    Engineering Excellence
                  </h3>
                </div>
                <p class="text-gray-600 text-center">
                  Pushing the boundaries of automotive engineering with
                  cutting-edge solutions
                </p>
              </div>
            </div>

            <!-- Center Innovation Hub -->
            <div
              class="md:row-span-2 group relative rounded-xl overflow-hidden my-auto"
            >
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <Image src={bh03} alt="f1 tech" loading="eager" />
                <h2 class="text-2xl font-light mb-4 text-gray-800">
                  Innovation Hub
                </h2>
                <p class="text-gray-600">
                  The heart of F1 technology, where engineering meets innovation
                  to create the future of motorsport. Every component is
                  optimized for maximum performance.
                </p>
              </div>
            </div>

            <!-- Analytics -->
            <div class="group relative rounded-xl overflow-hidden">
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <div class="flex flex-col items-center text-center mb-6">
                  <div class="bg-blue-50 p-4 rounded-full">
                    <i
                      class="bi bi-graph-up text-blue-500 text-2xl inline-block"
                    ></i>
                  </div>
                  <h3 class="text-lg text-gray-800 mt-4">Data Analytics</h3>
                </div>
                <p class="text-gray-600 text-center">
                  Real-time data analysis shapes strategy and performance
                  optimization
                </p>
              </div>
            </div>

            <!-- Aerodynamics -->
            <div class="group relative rounded-xl overflow-hidden">
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <div class="flex flex-col items-center text-center mb-6">
                  <div class="bg-cyan-50 p-4 rounded-full">
                    <i class="bi bi-wind text-cyan-500 text-2xl inline-block"
                    ></i>
                  </div>
                  <h3 class="text-lg text-gray-800 mt-4">Aerodynamics</h3>
                </div>
                <p class="text-gray-600 text-center">
                  Advanced research in airflow and downforce optimization
                </p>
              </div>
            </div>

            <!-- Performance -->
            <div class="group relative rounded-xl overflow-hidden">
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <div class="flex flex-col items-center text-center mb-6">
                  <div class="bg-orange-50 p-4 rounded-full">
                    <i
                      class="bi bi-speedometer2 text-orange-500 text-2xl inline-block"
                    ></i>
                  </div>
                  <h3 class="text-lg text-gray-800 mt-4">Performance</h3>
                </div>
                <p class="text-gray-600 text-center">
                  Maximizing speed and efficiency through innovative solutions
                </p>
              </div>
            </div>

            <!-- Sustainability -->
            <div
              class="md:col-span-3 group relative rounded-xl overflow-hidden"
            >
              <div class="bg-white/80 backdrop-blur-sm p-8">
                <div class="flex flex-col items-center text-center mb-6">
                  <div class="bg-green-50 p-4 rounded-full">
                    <i
                      class="bi bi-leaf-fill text-green-500 text-2xl inline-block"
                    ></i>
                  </div>
                  <h3 class="text-lg text-gray-800 mt-4">
                    Sustainability & Innovation
                  </h3>
                </div>
                <p class="text-gray-600 text-center">
                  Leading the charge in sustainable racing technologies while
                  pushing the boundaries of what's possible in motorsport
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Simulations Section -->
      <TwoColumnSection
        title="Augmented reality and virtual simulations"
        content={`
          <p>
          Augmented reality and virtual simulations are becoming increasingly important in the world of Formula One. Teams are using these technologies to improve their design and testing processes, allowing them to simulate different scenarios and test new components in a virtual environment. For example, engineers can use virtual simulations to test how changes to the car's aerodynamics will affect its performance, without the need for physical prototypes.
          </p>
          <p>
          Augmented reality is also being used to enhance the experience for fans, with apps that allow them to explore the cars and tracks in 3D. These technologies have the potential to transform the way that Formula One is developed and experienced, and are likely to become even more important in the years to come.
          </p>
          `}
        imageSrc={jp02}
        imageAlt="F1 Car Virtual Simulation"
        reversed={true}
        background="gray"
      />

      <!-- Technicalities Section -->
      <TwoColumnSection
        title="Technicalities to talk about"
        content={`
          <p>
          In recent years, Formula 1 has seen a number of technical changes aimed at improving the safety and competitiveness of the sport. One such change has been an increase in the minimum weight of the cars, which has been done to address concerns about the high speeds that F1 cars can reach. Additionally, new rules have been introduced around the use of wind tunnels and simulators, which are key tools used by teams to develop and test their cars.
          </p>

          <p>
          These changes have been designed to promote innovation and creativity within the sport, while also ensuring that F1 remains at the forefront of automotive technology. Overall, F1's focus on technical excellence and innovation has helped to cement its position as one of the most exciting and dynamic motorsports in the world.
          </p>
          `}
        imageSrc={jp02}
        imageAlt="F1 Car Technical Details"
      />

      <!-- Video Feature Section -->
      <section class="py-12 bg-slate-50">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-12">
              Experience F1 Technology
            </h2>

            <div class="rounded-xl overflow-hidden shadow-lg">
              <video
                class="w-full h-full object-cover rounded-xl"
                autoplay
                muted
                loop
                playsinline
              >
                <source
                  src="/src/assets/videos/raceseq.webm"
                  type="video/webm"
                />
                Your browser does not support the video tag.
              </video>
            </div>

            <div class="mt-8 text-center">
              <p class="text-gray-600 max-w-2xl mx-auto">
                Explore the cutting-edge technology that powers modern Formula 1
                cars, from advanced aerodynamics to hybrid power units.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Cost Cap Section -->
      <section class="py-16 bg-gradient-to-b from-slate-50 to-white">
        <div class="container mx-auto px-4">
          <div class="max-w-7xl mx-auto">
            <!-- Header with enhanced styling -->
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold mb-4">
                Cost Cap Impact
              </h2>
              <p class="text-lg text-gray-600 max-w-3xl mx-auto">
                Transforming F1's financial landscape with a $140M cost cap,
                creating a more competitive and sustainable future for the
                sport.
              </p>
            </div>

            <!-- Stats Bar - Key Metrics -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
              <div
                class="bg-white rounded-xl p-6 shadow-sm border border-gray-100"
              >
                <div class="flex items-center gap-4">
                  <div class="p-3 bg-green-50 rounded-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      class="bi bi-piggy-bank w-6 h-6 text-green-600"
                      viewBox="0 0 16 16"
                    >
                      <path
                        d="M5 6.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0m1.138-1.496A6.6 6.6 0 0 1 7.964 4.5c.666 0 1.303.097 1.893.273a.5.5 0 0 0 .286-.958A7.6 7.6 0 0 0 7.964 3.5c-.734 0-1.441.103-2.102.292a.5.5 0 1 0 .276.962"
                      ></path>
                      <path
                        fill-rule="evenodd"
                        d="M7.964 1.527c-2.977 0-5.571 1.704-6.32 4.125h-.55A1 1 0 0 0 .11 6.824l.254 1.46a1.5 1.5 0 0 0 1.478 1.243h.263c.3.513.688.978 1.145 1.382l-.729 2.477a.5.5 0 0 0 .48.641h2a.5.5 0 0 0 .471-.332l.482-1.351c.635.173 1.31.267 2.011.267.707 0 1.388-.095 2.028-.272l.543 1.372a.5.5 0 0 0 .465.316h2a.5.5 0 0 0 .478-.645l-.761-2.506C13.81 9.895 14.5 8.559 14.5 7.069q0-.218-.02-.431c.261-.11.508-.266.705-.444.315.306.815.306.815-.417 0 .223-.5.223-.461-.026a1 1 0 0 0 .09-.255.7.7 0 0 0-.202-.645.58.58 0 0 0-.707-.098.74.74 0 0 0-.375.562c-.024.243.082.48.32.654a2 2 0 0 1-.259.153c-.534-2.664-3.284-4.595-6.442-4.595M2.516 6.26c.455-2.066 2.667-3.733 5.448-3.733 3.146 0 5.536 2.114 5.536 4.542 0 1.254-.624 2.41-1.67 3.248a.5.5 0 0 0-.165.535l.66 2.175h-.985l-.59-1.487a.5.5 0 0 0-.629-.288c-.661.23-1.39.359-2.157.359a6.6 6.6 0 0 1-2.157-.359.5.5 0 0 0-.635.304l-.525 1.471h-.979l.633-2.15a.5.5 0 0 0-.17-.534 4.65 4.65 0 0 1-1.284-1.541.5.5 0 0 0-.446-.275h-.56a.5.5 0 0 1-.492-.414l-.254-1.46h.933a.5.5 0 0 0 .488-.393m12.621-.857a.6.6 0 0 1-.098.21l-.044-.025c-.146-.09-.157-.175-.152-.223a.24.24 0 0 1 .117-.173c.049-.027.08-.021.113.012a.2.2 0 0 1 .064.199"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Annual Budget</p>
                    <p class="text-2xl font-bold text-gray-900">$140M</p>
                  </div>
                </div>
              </div>
              <div
                class="bg-white rounded-xl p-6 shadow-sm border border-gray-100"
              >
                <div class="flex items-center gap-4">
                  <div class="p-3 bg-blue-50 rounded-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      class="bi bi-calendar-event w-6 h-6 text-blue-600"
                      viewBox="0 0 16 16"
                    >
                      <path
                        d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"
                      ></path>
                      <path
                        d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Race Calendar</p>
                    <p class="text-2xl font-bold text-gray-900">24 races</p>
                  </div>
                </div>
              </div>
              <div
                class="bg-white rounded-xl p-6 shadow-sm border border-gray-100"
              >
                <div class="flex items-center gap-4">
                  <div class="p-3 bg-purple-50 rounded-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      class="bi bi-people-fill w-6 h-6 text-purple-600"
                      viewBox="0 0 16 16"
                    >
                      <path
                        d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Teams</p>
                    <p class="text-2xl font-bold text-gray-900">10</p>
                  </div>
                </div>
              </div>
              <div
                class="bg-white rounded-xl p-6 shadow-sm border border-gray-100"
              >
                <div class="flex items-center gap-4">
                  <div class="p-3 bg-orange-50 rounded-lg">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      class="bi bi-speedometer w-6 h-6 text-orange-600"
                      viewBox="0 0 16 16"
                    >
                      <path
                        d="M8 2a.5.5 0 0 1 .5.5V4a.5.5 0 0 1-1 0V2.5A.5.5 0 0 1 8 2M3.732 3.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707M2 8a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 8m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.39.39 0 0 0-.527-.02L7.547 7.31A.91.91 0 1 0 8.85 8.569l3.434-4.297a.39.39 0 0 0-.029-.518z"
                      ></path>
                      <path
                        fill-rule="evenodd"
                        d="M6.664 15.889A8 8 0 1 1 9.336.11a8 8 0 0 1-2.672 15.78zm-4.665-4.283A11.95 11.95 0 0 1 8 10c2.186 0 4.236.585 6.001 1.606a7 7 0 1 0-12.002 0"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Pressure</p>
                    <p class="text-2xl font-bold text-gray-900">100%</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content Grid -->
            <div class="grid md:grid-cols-2 gap-8">
              <div class="space-y-4">
                <h3 class="text-xl font-semibold text-gray-900">
                  Financial Equality
                </h3>
                <p class="text-gray-600">
                  The introduction of a cost cap in Formula One marks a
                  significant shift towards financial sustainability. Teams are
                  now restricted to $140 million per year for car development,
                  leveling the playing field between established powerhouses and
                  smaller teams. This cap ensures that success is determined
                  more by innovation and efficiency than by financial might.
                </p>
                <ul class="space-y-2 text-gray-600">
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Balanced competition across all teams
                  </li>
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Focus on technical innovation
                  </li>
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Sustainable business model
                  </li>
                </ul>
              </div>
              <div class="space-y-4">
                <h3 class="text-xl font-semibold text-gray-900">
                  Impact on Competition
                </h3>
                <p class="text-gray-600">
                  This new approach prevents financial dominance from
                  determining championship outcomes. Teams must now prioritize
                  efficiency and strategic resource allocation, leading to more
                  unpredictable and exciting races. The cost cap has already
                  shown signs of narrowing the performance gap between teams,
                  creating more opportunities for midfield teams to compete for
                  podiums.
                </p>
                <ul class="space-y-2 text-gray-600">
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Closer racing battles
                  </li>
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    Efficient resource management
                  </li>
                  <li class="flex items-center gap-2">
                    <svg
                      class="w-5 h-5 text-green-500"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                    </svg>
                    More competitive midfield
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Data-Driven Section -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <!-- Header -->
          <div class="mb-16">
            <h2 class="text-3xl font-bold mb-4">Data-Driven Edge</h2>
            <p class="text-gray-600 text-lg">
              In today's F1, data is as critical as horsepower. Teams harness
              massive streams of telemetry and simulations to guide everything
              from race-day decisions to long-term car development, gaining an
              edge that's measured in milliseconds.
            </p>
          </div>

          <!-- Three Column Layout -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
            <!-- Text Column -->
            <div class="text-gray-600">
              <p>
                From tire degradation forecasts to predictive fuel strategies,
                F1 teams use advanced analytics to uncover patterns and
                possibilities that would otherwise go unnoticed. Every decision
                is backed by data — every outcome, optimized.
              </p>
            </div>

            <!-- Image Columns -->
            <div class="flex flex-col gap-4 items-center justify-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                class="size-24 border border-gray-300/80 rounded-full p-4"
                ><path
                  fill="currentColor"
                  d="M8 17v-.575q0-1.1 1.1-1.763T12 14t2.9.663t1.1 1.762V17zm4-4q-.825 0-1.412-.587T10 11t.588-1.412T12 9t1.413.588T14 11t-.587 1.413T12 13m-5 7.15q-2.875-.35-4.437-1.175T1 17V7q0-1.425 2.838-2.2T12 4.025t8.163.775T23 7v10q0 1.15-1.562 1.975T17 20.15v-12q1.275-.2 2.263-.488t1.412-.562Q19.6 6.675 17 6.338T12 6t-5 .338t-3.675.762q.425.3 1.413.575T7 8.15z"
                ></path></svg
              >
              <h5>Car Simulation</h5>
            </div>

            <div class="flex items-center justify-center">
              <Image
                src={bh03}
                alt="jp"
                class:list={"rounded-lg w-full object-cover aspect-square"}
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Teamwork Section -->
      <section class="py-12">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold mb-12">
            Teamwork makes the dream work
          </h2>

          <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto"
          >
            <!-- One Team Card -->
            <div class="space-y-4">
              <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gray-200 text-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8"
                  fill="text-gray-600"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v6a2.5 2.5 0 0 1-2.5 2.5H9.366a1 1 0 0 1-.866.5h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 .866.5H11.5A1.5 1.5 0 0 0 13 12h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"
                  ></path>
                </svg>
              </div>
              <h3 class="">One Team, One Goal</h3>
              <p class="text-gray-600">
                From factory to finish line, everyone works toward a single
                mission: performance. Designers, mechanics, and support staff
                all play a part. In F1, collaboration and unity turn potential
                into podiums.
              </p>
            </div>

            <!-- Brains Behind Card -->
            <div class="space-y-4">
              <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gray-200 text-white"
              >
                <svg
