---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`More - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container mx-auto px-4 py-8">
			<h1 class="text-4xl font-bold mb-8">More</h1>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<a href="/about" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
					<h2 class="text-xl font-semibold mb-2">About</h2>
					<p class="text-gray-600">Learn more about Tarmac and our mission</p>
				</a>
				<a href="/contact" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
					<h2 class="text-xl font-semibold mb-2">Contact</h2>
					<p class="text-gray-600">Get in touch with us</p>
				</a>
				<a href="/faqs" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
					<h2 class="text-xl font-semibold mb-2">FAQs</h2>
					<p class="text-gray-600">Find answers to common questions</p>
				</a>
				<a href="/attributions" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
					<h2 class="text-xl font-semibold mb-2">Attributions</h2>
					<p class="text-gray-600">Credits and acknowledgments</p>
				</a>
				<a href="/components" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
					<h2 class="text-xl font-semibold mb-2">Components</h2>
					<p class="text-gray-600">UI component showcase</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
