---
// Define the props that this component accepts
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  driver: CollectionEntry<"drivers">;
  year?: string;
}

const { driver, year = "2025" } = Astro.props;
---

<a href={`/seasons/${year}/drivers/${driver.id}`} class="block h-full">
  <article
    class="group bg-gray-100 rounded-xl overflow-hidden transition-all duration-300 h-full border border-gray-100 hover:border-gray-200"
  >
    <div class="p-4">
      {
        /* Main Grid Layout - 2 columns with flag and driver in first, position in second */
      }
      <div class="flex justify-between gap-4 items-start">
        {/* Left side with driver info */}
        <div class="flex flex-col">
          {/* Name with flag */}
          <div class="flex items-start gap-2">
            <h3 class="font-bold">
              <span class="text-lg text-gray-900 block"
                >{driver.data.firstName}</span
              >
              <span class="text-2xl text-gray-900 block -mt-1"
                >{driver.data.lastName}</span
              >
            </h3>
          </div>

          {/* Team */}
          <div class="mt-1">
            <span class="text-gray-600">{driver.data.team}</span>
          </div>

          {/* Number */}
          <span class="text-gray-500 mt-1">#{driver.data.number}</span>

          {/* Flag */}
          <span
            class={`mt-2 fi fi-${driver.data.countryCode}`}
            aria-hidden="true"></span>
        </div>

        {/* Position and Points - Right side */}
        <div class="text-end">
          <span
            class="text-2xl font-bold text-gray-900 block underline underline-offset-6 mb-2"
          >
            {driver.data.championshipPosition || "-"}
          </span>
          <span class="font-medium text-gray-900 block -mt-1"
            >{driver.data.points} pts</span
          >
        </div>
      </div>
    </div>

    {/* Driver Image */}
    <div
      class="h-40 overflow-hidden bg-gradient-to-t from-gray-300 to-gray-100"
    >
      <img
        src={driver.data.profileImage || "/blog-placeholder-1.jpg"}
        alt={`${driver.data.firstName} ${driver.data.lastName}`}
        class=""
        loading="lazy"
      />
    </div>
  </article>
</a>
