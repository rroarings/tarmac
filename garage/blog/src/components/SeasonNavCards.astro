---
interface Props {
	season: "2024" | "2025"
}

const { season } = Astro.props
---

<section class="py-12">
	<div class="container mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{/* Drivers Card */}
			<a
				href={`/seasons/${season}/drivers`}
				class="block group h-full">
				<div class="border border-gray-200 rounded-lg p-6 h-full">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-2xl font-bold text-gray-900 group-hover:text-red-600 transition-colors">
							Drivers
						</h3>
						<span
							class="text-gray-500 group-hover:translate-x-1 group-hover:text-red-600 transition-transform"
							>→</span
						>
					</div>
					<p class="text-gray-600">
						View all Formula 1 drivers competing in the {season} championship season. Explore driver
						profiles, statistics, and current championship standings.
					</p>
				</div>
			</a>

			{/* Constructors Card */}
			<a
				href={`/seasons/${season}/teams`}
				class="block group h-full">
				<div class="border border-gray-200 rounded-lg p-6 h-full">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-2xl font-bold text-gray-900 group-hover:text-red-600 transition-colors">
							Constructors
						</h3>
						<span
							class="text-gray-500 group-hover:translate-x-1 group-hover:text-red-600 transition-transform"
							>→</span
						>
					</div>
					<p class="text-gray-600">
						Discover the {season} Formula 1 constructor teams, their cars, and current standings. Learn
						about team principals, engines, and technical developments.
					</p>
				</div>
			</a>
		</div>
	</div>
</section>
