---
import { getCollection } from "astro:content";

interface Props {
  season: "2024" | "2025";
}

const { season } = Astro.props;

// Fetch all drivers and filter by the specified season
const allDrivers = await getCollection("drivers");
const seasonDrivers = allDrivers.filter(
  (driver) => driver.data.season === season,
);

// Sort drivers by championship position
const sortedDrivers = seasonDrivers.sort(
  (a, b) => a.data.championshipPosition - b.data.championshipPosition,
);

// Get the top 3 drivers
const topThree = sortedDrivers.slice(0, 3);

// Reorder to place the 1st driver in the middle
const displayOrder =
  topThree.length === 3 ? [topThree[1], topThree[0], topThree[2]] : topThree;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center pt-8 pb-16">
  {
    displayOrder.map((driver) => (
      <div
        class:list={[
          "rounded-lg p-6 text-left transition-transform duration-300",
          {
            "transform md:scale-110 border-1 border-red-300":
              driver.data.championshipPosition === 1,
            "border border-gray-200": driver.data.championshipPosition !== 1,
          },
        ]}
      >
        <img
          src={driver.data.profileImage}
          alt={`Portrait of ${driver.data.firstName} ${driver.data.lastName}`}
          class="w-32 h-32 rounded-full mx-auto mb-4 object-cover"
          loading="lazy"
        />
        <h3 class="text-xl font-bold text-gray-900">{`${driver.data.firstName} ${driver.data.lastName}`}</h3>
        <p class="text-gray-600">{driver.data.team}</p>
        <div class="mt-4 text-center">
          <p class="text-3xl font-bold">
            {driver.data.points} <span class="text-sm">pts</span>
          </p>
          <p class="text-sm text-gray-500">
            P {driver.data.championshipPosition}
          </p>
        </div>
      </div>
    ))
  }
</div>
