---
import { type CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { Image } from "astro:assets";

interface Props {
  race: CollectionEntry<"races">;
  completedRaces?: CollectionEntry<"races">[];
  isNextRace?: boolean;
  loading?: "eager" | "lazy";
}

const { race, completedRaces = [], isNextRace, loading = "lazy" } = Astro.props;

const parts = race.id.split("/");
const raceSlug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "");

const toUTCMidnight = (date: Date) => {
  const d = new Date(date);
  d.setUTCHours(0, 0, 0, 0);
  return d;
};

const nowUTC = toUTCMidnight(new Date());
const raceDateUTC = toUTCMidnight(new Date(race.data.date));
const sevenDaysFromNowUTC = new Date(nowUTC);
sevenDaysFromNowUTC.setDate(nowUTC.getDate() + 7);

const lastCompletedRaceDate =
  completedRaces.length > 0
    ? Math.max(
        ...completedRaces.map((r) =>
          toUTCMidnight(new Date(r.data.date)).getTime(),
        ),
      )
    : 0;
// Only mark as previous race if in current season
const currentSeason = new Date().getFullYear().toString();
const isCurrentSeason = race.data.season === currentSeason;
const isPreviousRace =
  isCurrentSeason &&
  race.data.completed &&
  raceDateUTC.getTime() === lastCompletedRaceDate;

let statusLabel = null;
let statusLabelClass = "";
if (isNextRace) {
  statusLabel = "Next Race";
  statusLabelClass = "bg-red-500 text-white motion-safe:animate-pulse";
} else if (isPreviousRace) {
  statusLabel = "Previous Race";
  statusLabelClass = "bg-blue-500 text-white";
} else if (race.data.completed) {
  statusLabel = "Completed";
  statusLabelClass = "bg-green-600 text-white";
} else {
  statusLabel = "Upcoming";
  statusLabelClass = "bg-gray-500 text-white";
}
---

<a href={`/seasons/${race.data.season}/races/${raceSlug}`} class="block h-full">
  <div
    class:list={[
      "group h-full border rounded-lg overflow-hidden transition-shadow duration-200 hover:shadow-md",
      {
        "border-red-200 bg-red-100/30 dark:bg-red-900 dark:border-red-600":
          isNextRace,
        "border-blue-200 bg-blue-100/30 dark:bg-blue-900 dark:border-blue-600":
          isPreviousRace,
        "border-green-200 bg-green-100/30 dark:bg-green-900 dark:border-green-600":
          race.data.completed && !isPreviousRace,
        "border-gray-200 bg-gray-100/20 dark:bg-slate-900 dark:border-slate-600":
          !isNextRace && !isPreviousRace && !race.data.completed,
      },
    ]}
  >
    {
      race.data.trackImage && (
        <Image
          src={race.data.trackImage}
          alt={race.data.trackImageAlt ?? `${race.data.trackName} circuit`}
          class="w-full h-48 object-cover"
          loading={loading}
        />
      )
    }
    <div class="p-4">
      <div class="flex items-center justify-between mb-4">
        {
          statusLabel && (
            <span
              class={`px-3 py-1 text-xs rounded-full font-medium transition-colors duration-200 ${statusLabelClass}`}
            >
              {statusLabel}
            </span>
          )
        }
      </div>
    </div>
    <div class="p-6">
      <p class="text-sm text-gray-500 dark:text-slate-300 mb-1">
        Race #{race.data.raceNumber}
      </p>

      <h3
        class="text-xl font-bold mb-2 dark:text-slate-100 dark:group-hover:underline"
      >
        {race.data.location}
      </h3>
      <p class="text-gray-600 mb-3 dark:text-slate-100">
        {race.data.trackName}
      </p>

      <div class="text-sm text-gray-600 dark:text-slate-300">
        <div class="flex justify-between items-center mb-1">
          <span>Date:</span>
          <span><FormattedDate date={race.data.date} /></span>
        </div>

        {
          race.data.completed && (
            <>
              <div class="flex justify-between items-center mb-1">
                <span>Winner:</span>
                <span>{race.data.winner}</span>
              </div>
              <div class="flex justify-between items-center">
                <span>Fastest Lap:</span>
                <span>{race.data.fastestLapTime}</span>
              </div>
            </>
          )
        }

        {
          !race.data.completed && (
            <div class="mt-4">
              <span
                class={`px-2 py-1 rounded text-xs font-medium transition-colors duration-200 ${
                  isNextRace
                    ? "bg-red-500 text-white"
                    : "bg-gray-200 text-gray-700"
                }`}
              >
                Upcoming
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</a>
