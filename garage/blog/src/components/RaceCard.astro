---
import { type CollectionEntry } from "astro:content"
import FormattedDate from "./FormattedDate.astro"

interface Props {
	race: CollectionEntry<"races">
	completedRaces?: CollectionEntry<"races">[]
	isNextRace?: boolean
}

const { race, completedRaces = [], isNextRace } = Astro.props

const parts = race.id.split("/")
const raceSlug = parts[parts.length - 1].replace(/\.(md|mdx)$/, "")

const toUTCMidnight = (date: Date) => {
	const d = new Date(date)
	d.setUTCHours(0, 0, 0, 0)
	return d
}

const nowUTC = toUTCMidnight(new Date())
const raceDateUTC = toUTCMidnight(new Date(race.data.date))
const sevenDaysFromNowUTC = new Date(nowUTC)
sevenDaysFromNowUTC.setDate(nowUTC.getDate() + 7)

const isPastRace = raceDateUTC.getTime() < nowUTC.getTime()
const isCurrentRace =
	!race.data.completed && !isPastRace && raceDateUTC.getTime() <= sevenDaysFromNowUTC.getTime()
const lastCompletedRaceDate =
	completedRaces.length > 0 ?
		Math.max(...completedRaces.map((r) => toUTCMidnight(new Date(r.data.date)).getTime()))
	: 0
const isPreviousRace = race.data.completed && raceDateUTC.getTime() === lastCompletedRaceDate

let statusLabel = null
let statusLabelClass = ""
if (isNextRace) {
	statusLabel = "Next Race"
	statusLabelClass = "bg-red-500 text-white motion-safe:animate-pulse"
} else if (isPreviousRace) {
	statusLabel = "Previous Race"
	statusLabelClass = "bg-blue-500 text-white"
} else if (race.data.completed) {
	statusLabel = "Completed"
	statusLabelClass = "bg-green-600 text-white"
} else if (!race.data.completed && isPastRace) {
	statusLabel = "Previous Race"
	statusLabelClass = "bg-yellow-500 text-white"
} else if (!race.data.completed && !isNextRace && !isPreviousRace && !isPastRace) {
	statusLabel = "Upcoming"
	statusLabelClass = "bg-gray-500 text-white"
}
---

<a
	href={`/seasons/${race.data.season}/races/${raceSlug}`}
	class="block h-full">
	<div
		class:list={[
			"h-full border rounded-lg overflow-hidden transition-shadow duration-200 hover:shadow-md",
			{
				"border-red-200 bg-red-100/30": isNextRace,
				"border-blue-200 bg-blue-100/30": isPreviousRace,
				"border-green-200 bg-green-100/30": race.data.completed && !isPreviousRace,
				"border-gray-200 bg-gray-100/20": !isNextRace && !isPreviousRace && !race.data.completed,
			},
		]}>
		{
			race.data.trackImage && (
				<img
					src={race.data.trackImage}
					alt={`${race.data.trackName} circuit`}
					class="w-full h-48 object-cover"
					loading="lazy"
				/>
			)
		}
		<div class="p-4">
			<div class="flex items-center justify-between mb-4">
				{statusLabel && (
					<span class={`px-3 py-1 text-xs rounded-full font-medium transition-colors duration-200 ${statusLabelClass}`}>{statusLabel}</span>
				)}
			</div>
		</div>
		<div class="p-6">
			<p class="text-sm text-gray-500 mb-1">Race #{race.data.raceNumber}</p>

			<h3 class="text-xl font-bold mb-2">{race.data.location}</h3>
			<p class="text-gray-600 mb-3">{race.data.trackName}</p>

			<div class="text-sm text-gray-600">
				<div class="flex justify-between items-center mb-1">
					<span>Date:</span>
					<span><FormattedDate date={race.data.date} /></span>
				</div>

				{
					race.data.completed && (
						<>
							<div class="flex justify-between items-center mb-1">
								<span>Winner:</span>
								<span>{race.data.winner}</span>
							</div>
							<div class="flex justify-between items-center">
								<span>Fastest Lap:</span>
								<span>{race.data.fastestLapTime}</span>
							</div>
						</>
					)
				}

				{
					!race.data.completed && (
						<div class="mt-4">
							<span
								class={`px-2 py-1 rounded text-xs font-medium transition-colors duration-200 ${
									isNextRace ? "bg-red-500 text-white" : "bg-gray-200 text-gray-700"
								}`}
							>
								Upcoming
							</span>
						</div>
					)
				}
			</div>
		</div>
	</div>
</a>
