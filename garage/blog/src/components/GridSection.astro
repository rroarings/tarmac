---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GridItem {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  title: string;
  items: GridItem[];
}

const { title, items } = Astro.props;
---

<section class="container mx-auto px-4 py-12">
  <div class="space-y-8">
    <h2 class="text-3xl font-bold">{title}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        items.map((item) => (
          <div class="group rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
            <div class="p-6 flex flex-col h-full">
              <h3 class="text-xl font-semibold mb-3 group-hover:text-blue-600 transition-colors duration-300">{item.title}</h3>
              <p class="text-gray-600 mb-6">{item.description}</p>
              <div class="mt-auto relative overflow-hidden rounded-lg">
                <Image
                  src={item.image}
                  alt={item.imageAlt || ""}
                  class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
                  width={800}
                  height={400}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
