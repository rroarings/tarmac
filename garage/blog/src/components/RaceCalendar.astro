---
import { getCollection } from "astro:content";
import RaceCard from "./RaceCard.astro";

interface Props {
  season: string;
  showAllRaces?: boolean;
  showTitle?: boolean;
  customClass?: string;
}

const {
  season,
  showAllRaces = false,
  showTitle = true,
  customClass = "",
} = Astro.props;

const races = await getCollection("races", ({ data }) => {
  return data.season === season;
});

type DateInput = string | number | Date;
const toUTCMidnight = (date: DateInput): Date => {
  const d = new Date(date);
  d.setUTCHours(0, 0, 0, 0);
  return d;
};

const nowUTC = toUTCMidnight(new Date());

const sortedRaces = races.slice().sort((a, b) => {
  const aDate = toUTCMidnight(a.data.date);
  const bDate = toUTCMidnight(b.data.date);
  return aDate.getTime() - bDate.getTime();
});

const completedRaces = sortedRaces.filter((race) => {
  const raceDate = toUTCMidnight(race.data.date);
  return race.data.completed || raceDate < nowUTC;
});
const upcomingRaces = sortedRaces.filter((race) => {
  const raceDate = toUTCMidnight(race.data.date);
  return !race.data.completed && raceDate >= nowUTC;
});

const lastCompletedRace = [...completedRaces].reverse().find(Boolean);

const nextTwoRaces = upcomingRaces.slice(0, 2);

const racesToDisplay = showAllRaces
  ? sortedRaces
  : [...(lastCompletedRace ? [lastCompletedRace] : []), ...nextTwoRaces];

const nextUpcomingRace = sortedRaces.find(
  (race) => !race.data.completed && toUTCMidnight(race.data.date) >= nowUTC,
);
---

<div class={`bg-gray-100 rounded ${customClass}`}>
	{showTitle && (
		<div class="flex items-center justify-between mb-6">
			<div class="flex items-center">
				<i class="bi bi-calendar3 text-3xl text-gray-700 mr-4" aria-label="Race Calendar Icon" />
				<h3 class="text-2xl font-semibold tracking-tight text-gray-900">{season} Race Calendar</h3>
			</div>
			{lastCompletedRace && (
				<a
					href={`/seasons/${season}/races`}
					class="text-gray-500 hover:text-red-600 font-medium transition-colors duration-200">
					View All Races
				</a>
			)}
		</div>
	)}

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-4 mb-8">
		{racesToDisplay.map((race) => (
			<RaceCard
				race={race}
				completedRaces={completedRaces}
				isNextRace={nextUpcomingRace && race.id === nextUpcomingRace.id}
			/>
		))}
	</div>
</div>
