---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  href: string;
  class?: string;
};

const { href, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;
// Only mark as active if href matches pathname exactly
const isActive = href === pathname;
---

<a
  href={href}
  class:list={[
    "px-3 py-2 rounded-md transition-all duration-300",
    {
      "text-blue-500 transition-all duration-300 hover:text-blue-400": isActive,
      "text-gray-700 dark:text-slate-400 transition-all duration-300 hover:text-gray-900 hover:bg-gray-200":
        !isActive,
    },
    className,
  ]}
  {...props}
>
  <slot />
</a>
